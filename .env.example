# =============================================================
# Neha AI HR Agent - environment variables
# Copy to .env and fill in your values:  cp .env.example .env
# Both the Next.js dashboard and the FastAPI backend read this file.
# =============================================================

# --- Supabase (dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (backend, server-side only - never expose this key) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Twilio (outbound calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Deepgram (speech-to-text and text-to-speech) ---
DEEPGRAM_API_KEY=

# --- Claude via AWS Bedrock ---
AWS_BEARER_TOKEN_BEDROCK=

# --- Google Calendar / Gmail OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App URLs (use your public tunnel URL for Twilio webhooks) ---
# BACKEND_URL: public address of the backend, used in Twilio webhooks and OAuth redirects.
# BACKEND_API_URL: where the dashboard's server actions call the backend.
# NEXT_PUBLIC_BACKEND_URL: where the browser calls the backend (OAuth links, audio, feedback form).
# Locally all three can be http://localhost:8000. When deployed, set them to your hosted backend URL.
BACKEND_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Branding used in candidate emails ---
HR_COMPANY_NAME=Our Company
HR_SENDER_NAME=Recruiting Team
HR_REPLY_TO=

# --- Security ---
# APP_SECRET: long random string shared by dashboard and backend; signs browser
# links (recordings, Google connect) and Twilio stream tokens.  openssl rand -hex 32
APP_SECRET=
# INTERNAL_API_KEY: our own workers (voice agent, Meet bot) send this to the API.
INTERNAL_API_KEY=
# SUPABASE_JWT_SECRET: only for Supabase projects still on the legacy HS256
# JWT secret. Newer projects are verified against the project JWKS.
SUPABASE_JWT_SECRET=
# Dev only: skip Twilio signature checks when a tunnel rewrites URLs.
SKIP_TWILIO_SIGNATURE=false

# --- Development only: skip login (uses the service key; never enable in production) ---
DISABLE_AUTH=false

# --- Backend operations ---
# Country for phone numbers typed without a +country code (ISO 3166 alpha-2).
DEFAULT_PHONE_REGION=IN
# Optional error reporting.
SENTRY_DSN=
LOG_LEVEL=INFO
# false = run the background-task worker as its own process:
#   cd backend && python -m app.workers.queue
RUN_QUEUE_WORKER=true

# --- LiveKit voice agent (voice_agent/) ---
# VOICE_RUNTIME=livekit sends phone calls through the LiveKit agent instead of
# the legacy Twilio Media Streams loop.
VOICE_RUNTIME=twilio
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=neha
# Outbound SIP trunk id from LiveKit (Twilio Elastic SIP behind it)
LIVEKIT_SIP_TRUNK_ID=
# Anthropic API gives the lowest latency; without it the agent uses Bedrock.
ANTHROPIC_API_KEY=
# cartesia | elevenlabs | deepgram
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=
# Warm transfer target for phone calls (E.164)
HR_TRANSFER_NUMBER=
# Tavus face for video channels (persona in echo mode with a LiveKit transport)
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=

# --- Interview room recordings (LiveKit Egress -> S3-compatible storage), optional ---
EGRESS_S3_BUCKET=
EGRESS_S3_REGION=
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
# Set for Cloudflare R2 / Supabase Storage / MinIO
EGRESS_S3_ENDPOINT=
# Public base URL for playback, e.g. https://<bucket>.r2.dev
EGRESS_PUBLIC_BASE_URL=
