{
  "name": "neha-meet-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Headless-browser bot that puts Neha (voice + Tavus face) into Google Meet by bridging the meeting to a LiveKit room",
  "type": "module",
  "scripts": {
    "build": "tsc -p . && node scripts/build-bridge.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "livekit-client": "^2.22.3",
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  }
}
